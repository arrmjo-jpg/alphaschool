includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app

    # Level 6 to start (Playbook Technical Debt Register: ratchet upward in
    # later phases as the team gains fluency and the codebase stabilizes —
    # do not jump straight to the max level against an empty codebase).
    level: 6

    # PHPStan 2.0 removed this boolean toggle; the equivalent is ignoring
    # the error identifier directly (see UPGRADING.md "Removed option
    # checkMissingIterableValueType").
    ignoreErrors:
        - identifier: missingType.iterableValue
